  <section id="projects" class="projects-page">
    <div class="upper">
      <div class="subtitle">
        Browse My Recent
      </div>
      <div class="title">
        Projects
      </div>
    </div>

    <div class="projects-container">
      <button class="carousel-btn left">&#10094;</button>

      <div class="carousel-wrapper"> 
        <div class="carousel">
          <div class="project-card">
            <img class="project-pics" src="personal-portfolio/cards-pics/sudoku.jpeg">
            <h3>Sudoku</h3>
            <p>An interactive sudoku game.</p>
          </div>

          <div class="project-card">
            <img class="project-pics" src="personal-portfolio/cards-pics/bar-chart.png">
            <h3>Bar Chart Race</h3>
            <p>Interactive bar chart race visualization.</p>
          </div>

          <div class="project-card">
            <img class="project-pics" src="personal-portfolio/cards-pics/project-pics.jpeg">
            <h3>Portfolio Website</h3>
            <p>My personal portfolio built with HTML and CSS.</p>
          </div>
        </div>
      </div> <button class="carousel-btn right">&#10095;</button>
    </div>
  </section>

<script>
  const carousel = document.querySelector(".carousel") as HTMLElement;
  const cards = document.querySelectorAll(".project-card");
  const btnRight = document.querySelector(".right");
  const btnLeft = document.querySelector(".left");

  let index = 0;
  const totalCards = cards.length;
  const tempoTroca = 5000;
  let autoPlayInterval: number;

  function moveCarousel() {
    if (carousel) {
      carousel.style.transform = `translateX(-${index * 100}%)`;
    }
  }

  function nextSlide() {
    index = (index + 1) % totalCards;
    moveCarousel();
  }

  function prevSlide() {
    index = (index - 1 + totalCards) % totalCards;
    moveCarousel();
  }

  function startAutoPlay() {
    stopAutoPlay(); // Garante que não existam múltiplos intervalos
    autoPlayInterval = window.setInterval(nextSlide, tempoTroca);
  }

  function stopAutoPlay() {
    clearInterval(autoPlayInterval);
  }

    // Eventos
  btnRight?.addEventListener("click", () => {
    nextSlide();
    startAutoPlay();
  });

  btnLeft?.addEventListener("click", () => {
    prevSlide();
    startAutoPlay();
  });

  // Melhora de experiência: para o autoplay quando o mouse está em cima
  carousel?.addEventListener("mouseenter", stopAutoPlay);
  carousel?.addEventListener("mouseleave", startAutoPlay);

  // Inicialização
  startAutoPlay();
</script>